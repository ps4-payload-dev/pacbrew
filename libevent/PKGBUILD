pkgname=ps4-payload-libevent
pkgver=2.1.12
pkgrel=1
pkgdesc="Event notification library"
url="https://libevent.org/"
arch=('any')
license=('BSD')
options=(!strip libtool staticlibs)
source=(https://github.com/libevent/libevent/releases/download/release-${pkgver}-stable/libevent-${pkgver}-stable.tar.gz)
sha256sums=('92e6de1be9ec176428fd2367677e61ceffc2ee1cb119035037a27d346b0403bb')

groups=('ps4-payload-dev')
makedepends=('ps4-payload-sdk' 'ps4-payload-zlib')

prepare() {
    if [ -z "${PS4_PAYLOAD_SDK}" ]; then
	export PS4_PAYLOAD_SDK=/opt/ps4-payload-sdk
    fi
}

build() {
    source "${PS4_PAYLOAD_SDK}/toolchain/orbis.sh"
    cd libevent-${pkgver}-stable

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared \
		--disable-openssl
    ${MAKE} V=1
}

package() {
    source "${PS4_PAYLOAD_SDK}/toolchain/orbis.sh"
    cd libevent-${pkgver}-stable

    export DESTDIR="${pkgdir}/${DESTDIR}"
    make install

    ${PS4_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"
}
