pkgname=ps4-payload-sqlite
pkgver=3.52.0
pkgrel=1
pkgdesc="A C library that implements an SQL database engine"
arch=('any')
license=('LicenseRef-Sqlite')
url="https://www.sqlite.org/"
options=(!strip libtool staticlibs)
source=(https://www.sqlite.org/2026/sqlite-src-3520000.zip)
sha256sums=('652a98ca833ed638809a52bec225a7f37799f71a995778f9ccb68ad03bd1fc11')

groups=('ps5-payload-dev')

prepare() {
    if [ -z "${PS4_PAYLOAD_SDK}" ]; then
	export PS4_PAYLOAD_SDK=/opt/ps4-payload-sdk
    fi
}

build() {
    source "${PS4_PAYLOAD_SDK}/toolchain/orbis.sh"
    cd sqlite-src-3520000

    ./configure --prefix="${PREFIX}" --host=x86_64-pc-freebsd \
		--enable-static --disable-shared
    ${MAKE} sqlite3.h libsqlite3.a sqlite3.pc CFLAGS=-Dfdatasync=fsync
}


package() {
    source "${PS4_PAYLOAD_SDK}/toolchain/orbis.sh"
    cd sqlite-src-3520000

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} install-lib install-pc
    install -d "${DESTDIR}/${PREFIX}/include/"
    install -m 0644 sqlite3.h "${DESTDIR}/${PREFIX}/include/"

    ${PS4_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"
}
